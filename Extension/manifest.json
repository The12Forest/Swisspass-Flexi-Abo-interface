{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "flexiabo-bridge@swisspass.local",
      "strict_min_version": "109.0"
    }
  },
  "name": "SwissPass FlexiAbo Bridge",
  "version": "1.0.0",
  "description": "Synchronisiert Cookies und Tokens mit deinem lokalen SwissPass FlexiAbo Server",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.swisspass.ch/*",
    "https://login.swisspass.ch/*",
    "*://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.swisspass.ch/*", "https://login.swisspass.ch/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.swisspass.ch/*", "https://login.swisspass.ch/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SwissPass FlexiAbo Bridge"
  }
}
